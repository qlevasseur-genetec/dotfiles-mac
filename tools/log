#!/usr/bin/env bash

# ==============================================================================
# NAME
#   log - A CLI standard logger with severity levels, timestamps, and verbose control.
#
# SYNOPSIS
#   log <LEVEL> "Message text" [--verbose|-v] [--timestamp|-t]
#
# OPTIONS
#   -v, --verbose    Enable printing of 'debug' level messages.
#   -t, --timestamp  Enable rendering of timestamps (OFF by default).
#   -h, --help       Displays documentation.
#
# ENVIRONMENT VARIABLES
#   LOG_VERBOSE      Set to 'true' or '1' to globally enable debug logging.
#   LOG_TIMESTAMP    Set to 'true' or '1' to globally enable timestamps.
#   NO_COLOR         Set to '1' to disable ANSI color codes.
# ==============================================================================

set -euo pipefail

# ANSI Color Codes (Disable if NO_COLOR is set)
if [ "${NO_COLOR:-0}" = "1" ]; then
    COLOR_RESET=""
    COLOR_INFO=""
    COLOR_SUCCESS=""
    COLOR_WARN=""
    COLOR_ERROR=""
    COLOR_DEBUG=""
else
    COLOR_RESET=$'\033[0m'
    COLOR_INFO=$'\033[0;34m'    # Blue
    COLOR_SUCCESS=$'\033[0;32m' # Green
    COLOR_WARN=$'\033[0;33m'    # Yellow
    COLOR_ERROR=$'\033[0;31m'   # Red
    COLOR_DEBUG=$'\033[0;35m'   # Purple
fi

usage() {
    echo "Usage: log <LEVEL> \"Message\" [--verbose|-v] [--timestamp|-t]"
    echo ""
    echo "Levels: info | success | warn | error | debug"
    echo "Flags :"
    echo "  -v, --verbose    Enable printing of debug logs"
    echo "  -t, --timestamp  Show timestamp in output (Default: OFF)"
    echo "  -h, --help       Show full documentation"
    exit 0
}

# Check for empty arguments or help request
if [ $# -lt 1 ] || [ "$1" = "-h" ] || [ "$1" = "--help" ]; then
    usage
fi

LEVEL=$(echo "$1" | tr '[:upper:]' '[:lower:]')
shift

if [ $# -lt 1 ]; then
    echo "Error: Missing message for log level '$LEVEL'." >&2
    exit 1
fi

MESSAGE="$1"
shift

# Check remaining args for flags or environment variables
VERBOSE="${LOG_VERBOSE:-false}"
SHOW_TIMESTAMP="${LOG_TIMESTAMP:-false}"

while [ $# -gt 0 ]; do
    case "$1" in
        -v|--verbose)
            VERBOSE="true"
            shift
            ;;
        -t|--timestamp)
            SHOW_TIMESTAMP="true"
            shift
            ;;
        *)
            shift
            ;;
    esac
done

# Format timestamp string if enabled
TIME_STR=""
if [ "$SHOW_TIMESTAMP" = "true" ] || [ "$SHOW_TIMESTAMP" = "1" ]; then
    TIME_STR="[$(date +"%Y-%m-%d %H:%M:%S")] "
fi

# Process logging level
case "$LEVEL" in
    info)
        echo -e "${TIME_STR}${COLOR_INFO}[INFO]${COLOR_RESET} ${MESSAGE}"
        ;;
    success)
        echo -e "${TIME_STR}${COLOR_SUCCESS}[SUCCESS]${COLOR_RESET} ${MESSAGE}"
        ;;
    warn)
        echo -e "${TIME_STR}${COLOR_WARN}[WARN]${COLOR_RESET} ${MESSAGE}"
        ;;
    error)
        echo -e "${TIME_STR}${COLOR_ERROR}[ERROR]${COLOR_RESET} ${MESSAGE}" >&2
        ;;
    debug)
        if [ "$VERBOSE" = "true" ] || [ "$VERBOSE" = "1" ]; then
            echo -e "${TIME_STR}${COLOR_DEBUG}[DEBUG]${COLOR_RESET} ${MESSAGE}"
        fi
        ;;
    *)
        echo -e "${TIME_STR}${COLOR_ERROR}[ERROR]${COLOR_RESET} Unknown log level '$LEVEL'. Valid levels: info, success, warn, error, debug." >&2
        exit 1
        ;;
esac